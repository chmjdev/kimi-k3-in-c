{
  "name": "kimik3dev",
  "version": "1.0.0",
  "suite": "binteca",
  "type": "backend",
  "runtime": "python",
  "driver": "native",
  "repo": "",
  "disabled": true,
  "disable_automation": true,
  "note": "Not a port-bound web service; excluded from JCDS supervision.",
  "ports": {
    "dev": 0,
    "uat": 0,
    "prod": 0
  },
  "domains": {
    "uat": "",
    "prod": ""
  },
  "lifecycle": {
    "run": {
      "dev": "./run.sh dev",
      "uat": "./run.sh uat",
      "prod": "./run.sh prod"
    },
    "restart": {
      "dev": "./run.sh restart",
      "uat": "./run.sh restart",
      "prod": "./run.sh restart"
    },
    "update": {
      "command": "git pull origin main",
      "auto_stash": true
    },
    "startup_checks": {
      "command": "",
      "timeout_seconds": 15
    }
  },
  "health_check": {
    "path": "/health",
    "interval_seconds": 5,
    "timeout_seconds": 3,
    "max_retries": 5
  },
  "env_vars": {
    "required": [
      "PORT"
    ]
  }
}
